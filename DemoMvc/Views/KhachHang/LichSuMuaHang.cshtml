@model DemoMvc.Models.ViewModels.KhachHangDetailsVM

@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<h1>Lịch sử mua hàng của khách hàng: @Model.TenKH</h1>

<table class="table">
    <thead>
        <tr>
            <th>Mã Đơn</th>
            <th>Ngày Đặt</th>
            <th>Tổng Tiền</th>
            <th>Sản Phẩm</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var don in Model.DanhSachDon)
        {
            <tr>
                <td>@don.MaDH</td>
                <td>@don.NgayDat.ToString("dd/MM/yyyy")</td>
                <td>@don.TongTien.ToString("N0") VNĐ</td>
                <td>@string.Join(", ", don.TenSanPhams)</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>