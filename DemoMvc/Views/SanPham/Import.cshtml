@model IEnumerable<DemoMvc.Models.Entities.SanPham>

<div class="container">
    <h2>Nhập Sản phẩm từ Excel</h2>
    <form asp-action="Import" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <input type="file" name="file" class="form-control" accept=".xlsx, .xls" required />
        </div>
        <button type="submit" class="btn btn-primary">Tải lên và Lưu</button>
    </form>
</div>